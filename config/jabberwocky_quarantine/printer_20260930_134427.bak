[quad_gantry_level]
gantry_corners:
   -60.0,-10.0
   240.0,240.0
points:
   20.0,25.0
   25.0,130.0
   155.0,130.0
   155.0,25.0
speed: 200
horizontal_move_z: 10
retries: 5
retry_tolerance: 0.0075
max_adjust: 10

[bed_mesh]
speed: 200
horizontal_move_z: 10
zero_reference_position: 87.5, 95.5
mesh_min: 20, 51
mesh_max: 155, 156
probe_count: 5, 5
algorithm: bicubic



# JWStall_Test Stage 0 read-only observation logger
# JWStall Observation read-only logger
[include stage0_observation.cfg]


