## Z0 Stepper - Front Left
## Connected to STEPPER 0
## Endstop connected to Z-ENDSTOP header (PC3)
[stepper_z]
step_pin: PD4
dir_pin: !PD3
enable_pin: !PD7
rotation_distance: 40
gear_ratio: 9:1 
microsteps: 16
endstop_pin: ^PC3                    # Leviathan 1.4 Z-ENDSTOP port
position_endstop: 0.0                
position_max: 170                    
position_min: -4.5                 # Safety limit truncating downward over-travel

[tmc2209 stepper_z]
uart_pin: PD5
diag_pin: ^!PD6
interpolate: false
run_current: 0.7
sense_resistor: 0.110
stealthchop_threshold: 1

##  Z1 Stepper - Rear Left
##  Connected to STEPPER 1
[stepper_z1]
step_pin: PC12 #PD10 #PC12
dir_pin: PC11 #PD9 #PC11
enable_pin: !PD2 #PD13 #!PD2
rotation_distance: 40
gear_ratio: 9:1 
microsteps: 16

[tmc2209 stepper_z1]
uart_pin: PD0 #PD11 #PD0
#diag_pin: PD12 #^!PD1
interpolate: false
run_current: 0.7
sense_resistor: 0.110
stealthchop_threshold: 1

##  Z2 Stepper - Rear Right
##  Connected to STEPPER 2
[stepper_z2]
step_pin: PC9
dir_pin: !PC8
enable_pin: !PC10
rotation_distance: 40
gear_ratio: 9:1 
microsteps: 16

[tmc2209 stepper_z2]
uart_pin: PA8
#diag_pin: ^!PA15
interpolate: false
run_current: 0.7
sense_resistor: 0.110
stealthchop_threshold: 1


##  Z3 Stepper - Front Right
##  Connected to STEPPER 3
[stepper_z3]
step_pin: PG7
dir_pin: PG6
enable_pin: !PC7
rotation_distance: 40
gear_ratio: 9:1 
microsteps: 16

[tmc2209 stepper_z3]
uart_pin: PG8
#diag_pin: ^!PC6
interpolate: false
run_current: 0.7
sense_resistor: 0.110
stealthchop_threshold: 1

[include jabberwockyprobe/jwprobe_entry.cfg]

#####################################################################
# ███████╗██╗  ██╗████████╗██████╗ ██╗   ██╗██████╗ ███████╗██████╗     ███████╗███████╗████████╗████████╗██╗███╗   ██╗ ██████╗ ███████╗
# ██╔════╝╚██╗██╔╝╚══██╔══╝██╔══██╗██║   ██║██╔══██╗██╔════╝██╔══██╗    ██╔════╝██╔════╝╚══██╔══╝╚══██╔══╝██║████╗  ██║██╔════╝ ██╔════╝
