[include bedfans.cfg]

[multi_pin my_controller_fan_pins_1]
pins: PB7, PB3, PF1

[temperature_fan 3_ELECTRONICS_FANS]
pin: multi_pin:my_controller_fan_pins_1
kick_start_time: 1.0
#shutdown_speed: 0
off_below: 0.15
max_power: 1.0
#fan_speed: 0.75
sensor_type: temperature_host
control: pid
min_temp: -40
max_temp: 85
#max_delta: 5.0
pid_kp: 1.0
pid_ki: 0.5
pid_kd: 2.0
min_speed: 0.1
max_speed: .6
target_temp: 55

[temperature_fan controller_fan]
pin: PF7
kick_start_time: 1.0
#shutdown_speed: 0
off_below: 0.15
max_power: 1.0
#fan_speed: 0.75
sensor_type: temperature_mcu
control: pid
min_temp: -40
max_temp: 85
#max_delta: 5.0
pid_kp: 1.0
pid_ki: 0.5
pid_kd: 2.0
min_speed: 0.1
max_speed: .7
target_temp: 55


