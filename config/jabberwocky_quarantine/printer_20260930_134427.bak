# ROTATION DISTANCE is calibrated by marking 110mm on filament - if 
# the mark is under 10mm, this means it is over (count from the 
# 10mm mark down and add to 100); therefore, that value multiplied with 
# current value will give a new value, e.g. measure 104mm extrusion 
# would be 1.04 x current value = new value. The opposite example would
# be counting up from the 10mm mark and minus from 100, e.g. 4mm measured 
# = 96mm under is .96 x current value = new value
#rotation_distance: 21.882152864 

[extruder]
step_pin: nhk:gpio23
dir_pin: !nhk:gpio24
enable_pin: !nhk:gpio25
microsteps: 32
rotation_distance: 35.13664
gear_ratio: 44:8, 25:17 #44:8, 25:17=8T 
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin: nhk:gpio9
sensor_type: Generic 3950
sensor_pin: nhk:gpio29
pullup_resistor: 2200
#control: pid                                                        # Do PID calibration after initial checks
#pid_Kp: 28.182
#pid_Ki: 1.978
#pid_Kd: 100.397
min_temp: 0
max_temp: 315
min_extrude_temp: 20
max_extrude_only_distance: 1000
max_extrude_cross_section: 40
pressure_advance: 0.042                                             # See tuning pressure advance doc
pressure_advance_smooth_time: 0.040

[tmc2209 extruder]
uart_pin: nhk:gpio0
tx_pin: nhk:gpio1
interpolate: false
run_current: 0.55
sense_resistor: 0.100
# 🚀 HYBRID TORQUE CROSSOVER GATE:
# Automatically locks driver in StealthChop for clean metrology passes at <= 5mm/s.
# Instantly flips to SpreadCycle for maximum raw driving torque when printing > 7mm/s.
stealthchop_threshold: 7.0
driver_TBL: 1
driver_TOFF: 3
driver_HSTRT: 0
driver_HEND: 3

#[tmc2209 extruder]
#sense_resistor: 0.110
#uart_pin: nhk:gpio0
#tx_pin: nhk:gpio1
#interpolate: false
#run_current: 0.6        #recommend setting it below 0.7A.



#####################################################################
# ██████╗ ███████╗██████╗     ██╗  ██╗███████╗ █████╗ ████████╗███████╗██████╗ 
