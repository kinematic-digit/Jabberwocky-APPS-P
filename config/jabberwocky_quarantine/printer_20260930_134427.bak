#############################################################################################################
#####################################################################
##  B Stepper - Left (Connected to HV STEPPER 0)
#####################################################################

[stepper_x]
step_pin: PB10
dir_pin: !PB11                       
enable_pin: !PG0
rotation_distance: 32
microsteps: 32
endstop_pin: tmc5160_stepper_x:virtual_endstop
full_steps_per_rotation: 200                              
position_min: -5                     
position_endstop: 175
position_max: 175
homing_speed: 75                     # First (Fast) edge speed
homing_retract_dist: 0               # Must be 0: Handled manually by macro
homing_positive_dir: true            # Homes to positive max (X=176)

[tmc5160 stepper_x]
cs_pin: PE15
spi_bus: spi4
interpolate: false
run_current: 1.1
sense_resistor: 0.075
diag0_pin: ^!PG1                 
#driver_SGT: 3                      # REMOVED FOR TMC AUTOTUNE


#####################################################################
##  A Stepper - Right (Connected to HV STEPPER 1)
#####################################################################

[stepper_y]
step_pin: PF15
dir_pin: !PF14                       
enable_pin: !PE9
rotation_distance: 32
microsteps: 32                      
full_steps_per_rotation: 200        
endstop_pin: tmc5160_stepper_y:virtual_endstop 
position_min: 0
position_endstop: 191
position_max: 191
homing_speed: 75                     # First (Fast) edge speed
homing_retract_dist: 0               # Must be 0: Handled manually by macro
homing_positive_dir: true            # Homes to positive max (Y=190)

[tmc5160 stepper_y]
cs_pin: PE11
spi_bus: spi4
interpolate: false
run_current: 1.1
sense_resistor: 0.075
diag0_pin: ^!PE10                
#driver_SGT: 2                      # REMOVED FOR TMC AUTOTUNE


[gcode_macro HOME_X]
gcode:
    # Fetch configured run_current to restore automatically
    {% set RUN_CURRENT_X = printer.configfile.settings['tmc5160 stepper_x'].run_current %}
    
    # Set soft homing current (0.35A for LDO-35STH52)
    SET_TMC_CURRENT STEPPER=stepper_x CURRENT=0.35
    G4 P200
    
    # Home X axis
    G28 X
    
    # Back off 10mm from the stop
    G91
    G1 X10 F1200
    G90
    
    # Restore operational run_current
    SET_TMC_CURRENT STEPPER=stepper_x CURRENT={RUN_CURRENT_X}


[gcode_macro HOME_Y]
gcode:
    # Fetch configured run_current to restore automatically
    {% set RUN_CURRENT_Y = printer.configfile.settings['tmc5160 stepper_y'].run_current %}
    
    # Set soft homing current (0.35A for LDO-35STH52)
    SET_TMC_CURRENT STEPPER=stepper_y CURRENT=0.35
    G4 P200
    
    # Home Y axis
    G28 Y
    
    # Back off 10mm from the rear stop
    G91
    G1 Y-10 F1200
    G90
    
    # Restore operational run_current
    SET_TMC_CURRENT STEPPER=stepper_y CURRENT={RUN_CURRENT_Y}

#########################################################################################
# ███████╗    ███████╗███████╗████████╗████████╗██╗███╗   ██╗ ██████╗ ███████╗
