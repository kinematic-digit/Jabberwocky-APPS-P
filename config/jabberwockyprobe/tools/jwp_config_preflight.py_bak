#!/usr/bin/env python3
"""Read-only Klipper configuration preflight and hygiene scrubber for Jabberwocky Probe 2.0.
Author / Created by: Kinematicdigit (Jabberwocky Team)
Project home: https://github.com/kinematicdigit/jabberwockyprobe1.2

This intentionally runs outside Klipper. A gcode macro cannot run when a
duplicate section or command prevents Klipper from loading the configuration.
"""

from __future__ import annotations

import argparse
import glob
import os
import re
import shutil
import sys
import textwrap
from collections import defaultdict
from datetime import datetime
from pathlib import Path

# Bump SCRIPT_REVISION and SCRIPT_REVISION_DATE together whenever this file
# changes -- printed at the top of every report so a user can tell which
# scanner build produced a given report (e.g. when comparing bench notes
# or filing an issue against a specific behavior).
SCRIPT_REVISION = "r19"
SCRIPT_REVISION_DATE = "2026-09-19"
SCRIPT_AUTHOR = "Kinematicdigit (Jabberwocky Team)"
SCRIPT_PROJECT_URL = "https://github.com/kinematicdigit/jabberwockyprobe1.2"

SECTION_RE = re.compile(r"^\s*\[([^\]]+)\]\s*(?:[#;].*)?$")
INCLUDE_RE = re.compile(r"^\s*\[include\s+([^\]]+)\]\s*(?:[#;].*)?$", re.I)
DISABLED_INCLUDE_RE = re.compile(r"^\s*[#;]+\s*\[include\s+([^\]]+)\]\s*$", re.I)
OPTION_RE = re.compile(r"^\s*([A-Za-z_][\w-]*)\s*:")
MACRO_RE = re.compile(r"^\s*\[gcode_macro\s+([^\]]+)\]\s*$", re.I)
PIN_OPTION_RE = re.compile(r"^(?:.*_pin|pin)$", re.I)
VIRTUAL_PINS = {"virtual_endstop", "probe:z_virtual_endstop", "none", "nil"}

# Klipper's auto-generated SAVE_CONFIG block prefixes every line with
# "#*#" and writes options as "key = value" (not "key: value" like a
# hand-authored section) -- both need their own regex since the block is
# otherwise indistinguishable from a plain comment to a naive scanner.
SAVE_CONFIG_CONTENT_RE = re.compile(r"^\s*#\*#\s?(.*)$")
SAVE_CONFIG_OPTION_RE = re.compile(r"^\s*([A-Za-z_][\w-]*)\s*=\s*(.*)$")

RENAME_RE = re.compile(r"^\s*rename_existing\s*:\s*(\S+)", re.I)

